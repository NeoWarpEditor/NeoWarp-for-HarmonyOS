// HarmonyOS 7 / API 26 工程级构建配置
// 说明：compatibleSdkVersion / compileSdkVersion 以 DevEco Studio 实际安装的 SDK 为准，
//       若 SDK 以 "7.0.0(26)" 形式标识，可等价替换为字符串形式。
{
  "app": {
    "signingConfigs": [],
    "multiProjects": false,
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "26.0.0",
        "compileSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "arkTSVersion": "1.1"
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
